# ── OpenCode Orchestrator configuration ──────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF-your-bot-token

# Comma-separated list of authorized Telegram user IDs (numeric)
AUTHORIZED_USERS=11111111,22222222

# Path to the OpenCode CLI binary (e.g. /usr/local/bin/opencode)
OPENCODE_PATH=opencode

# Redis connection string for BullMQ queues
REDIS_URL=redis://localhost:6379

# GitHub token used by the Git module for push operations
GITHUB_TOKEN=ghp_your_github_token

# Default repository slug (must match a Repository row seeded in DB)
DEFAULT_REPOSITORY=my-project

# HTTP port for the API / health / webhook endpoints
PORT=3000

# Telegram webhook base URL (leave empty to use long polling)
WEBHOOK_DOMAIN=

# Database file for development (SQLite)
DATABASE_URL=file:./dev.db

# Logging level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Maximum concurrent OpenCode executions
MAX_CONCURRENT_TASKS=3

# Per-task execution timeout in milliseconds (0 = no timeout)
TASK_TIMEOUT_MS=1800000
