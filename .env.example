# ── REQUIRED ──────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF-your-bot-token

# ── OPTIONAL ──────────────────────────────────────────────────────────
# Comma-separated list of authorized Telegram user IDs (numeric).
# If empty or unset, anyone with the bot token can use the bot.
AUTHORIZED_USERS=

# Redis connection string for BullMQ queues
REDIS_URL=redis://localhost:6379

# App-level GitHub token (for the orchestrator's own GitHub API access)
# GITHUB_TOKEN=ghp_your_github_token

# HTTP port for the API / health / webhook endpoints
PORT=3000

# Telegram webhook base URL (leave empty to use long polling)
WEBHOOK_DOMAIN=

# Database file for development (SQLite)
DATABASE_URL=file:./dev.db

# Logging level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Maximum concurrent OpenCode executions
MAX_CONCURRENT_TASKS=3

# Per-task execution timeout in milliseconds (0 = no timeout)
TASK_TIMEOUT_MS=1800000

# Host path where workspace directories are created (auto-assigned)
WORKSPACE_ROOT=/data/workspaces

# Workspace container image (used by DockerWorkspaceService)
WORKSPACE_IMAGE=opencode-cloud-agent/workspace:latest

# Docker socket path (auto-detected: Windows → named pipe, Unix → /var/run/docker.sock)
# DOCKER_SOCKET=//./pipe/docker_engine

# Enable/disable workspace containers (set to 'false' to disable)
WORKSPACE_CONTAINERS_ENABLED=true

# Telegram Mini App URL (used for WebApp buttons; defaults to webhook-domain/mini-app or localhost)
# MINI_APP_URL=https://your-domain.com/mini-app
