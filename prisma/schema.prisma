// Prisma schema for OpenCode Orchestrator
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A workspace is a working directory (may or may not be a git repo).
/// Workspaces can contain multiple git projects and are the primary
/// context for OpenCode sessions.
model Tenant {
  id             String   @id @default(cuid())
  telegramUserId String   @unique
  displayName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaces     Workspace[]
}

model Workspace {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  workDir      String
  containerId  String?
  providerId   String?
  apiKey       String?
  gitToken     String?
  gitUsername  String?
  model        String?
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects  WorkspaceProject[]
  sessions  OpenCodeSession[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model WorkspaceProject {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  gitPath        String
  path           String   @default(".")
  branch         String   @default("main")
  remoteUrl      String?
  autoInstall    Boolean  @default(true)
  installCommand String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, path])
}

model OpenCodeSession {
  id        String   @id @default(cuid())
  publicId  String   @unique
  createdBy String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt    String
  active    Boolean  @default(true)
  streaming Boolean  @default(true)
  chatId    String?
  streamMessageId Int?
  pid       Int?
  output    String   @default("")
  errorMessage String?
  durationMs Int?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([createdBy])
}
